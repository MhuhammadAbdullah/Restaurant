{
  "name": "restaurant-mgmt",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @restaurant/database exec prisma generate",
    "db:migrate": "pnpm --filter @restaurant/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @restaurant/database exec tsx prisma/seed.ts",
    "db:studio": "pnpm --filter @restaurant/database exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
